---
// Illustrated exploded view of an asphalt shingle roof system. Pure SVG and CSS,
// no video, no frame sequences. Labelled as an illustration, not a photo of a project.

const BL = [70, 330], BR = [420, 330], TR = [640, 150], TL = [290, 150];
const at = (t: number) => ({
  y: BL[1] + (TL[1] - BL[1]) * t,
  xl: BL[0] + (TL[0] - BL[0]) * t,
  xr: BR[0] + (TR[0] - BR[0]) * t,
});
const band = (t0: number, t1: number) => {
  const a = at(t0), b = at(t1);
  return `${a.xl},${a.y} ${a.xr},${a.y} ${b.xr},${b.y} ${b.xl},${b.y}`;
};
const plane = band(0, 1);
const thickness = 12;
const bottomFace = `${BL[0]},${BL[1]} ${BR[0]},${BR[1]} ${BR[0]},${BR[1] + thickness} ${BL[0]},${BL[1] + thickness}`;
const leftFace = `${BL[0]},${BL[1]} ${TL[0]},${TL[1]} ${TL[0]},${TL[1] + thickness} ${BL[0]},${BL[1] + thickness}`;

const rows = 9;
const shingleRows = Array.from({ length: rows }, (_, i) => ({
  poly: band(i / rows, (i + 1) / rows),
  shade: i % 2 === 0 ? '#3d3e41' : '#46474a',
  t: i / rows,
}));
const ticks: string[] = [];
for (let i = 0; i < rows; i++) {
  const a = at(i / rows), b = at((i + 0.55) / rows);
  const offset = i % 2 === 0 ? 0 : 0.5;
  for (let k = 0; k < 6; k++) {
    const u = (k + offset + 0.5) / 6;
    const x1 = a.xl + (a.xr - a.xl) * u;
    const x2 = b.xl + (b.xr - b.xl) * u;
    ticks.push(`M${x1.toFixed(1)},${a.y.toFixed(1)} L${x2.toFixed(1)},${b.y.toFixed(1)}`);
  }
}
const underlayLines = [0.22, 0.44, 0.66, 0.88].map((t) => {
  const p = at(t);
  return `M${p.xl},${p.y} L${p.xr},${p.y}`;
});
const deckSeams = [0.33, 0.66].map((u) => {
  const a = at(0), b = at(1);
  return `M${a.xl + (a.xr - a.xl) * u},${a.y} L${b.xl + (b.xr - b.xl) * u},${b.y}`;
});

const layers = [
  { name: 'Roof deck', text: 'Plywood or OSB sheathing. Checked after tear off and replaced where it is soft.' },
  { name: 'Ice and water barrier', text: 'Self sealing membrane at the eaves, valleys, and around penetrations.' },
  { name: 'Synthetic underlayment', text: 'A second water barrier across the whole deck, under everything you can see.' },
  { name: 'Starter strip', text: 'Seals the first course of shingles against wind lift at the edge.' },
  { name: 'Architectural shingles', text: 'Or metal panels on a metal system. The part that shows, and the part that takes the weather.' },
  { name: 'Ridge vent, flashing, and drip edge', text: 'Where most leaks begin and where the details earn their keep.' },
];
---

<section class="layers section section-ink" aria-labelledby="layers-heading" data-layers>
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">How a roof goes together</p>
        <h2 id="layers-heading">Six layers between the weather and your ceiling.</h2>
      </div>
      <p class="lede">A new roof is more than shingles. When we write a proposal, every one of these layers is listed so you can see what you are paying for.</p>
    </div>

    <div class="grid-layers">
      <div class="art" aria-hidden="true">
        <svg viewBox="0 -110 720 470" role="img" focusable="false">
          <title>Exploded view of a shingle roof system</title>
          <ellipse cx="370" cy="352" rx="300" ry="16" fill="rgba(0,0,0,0.45)" />
          <g class="l" style="--i:0"><g class="e">
            <polygon points={bottomFace} fill="#8f6f46" />
            <polygon points={leftFace} fill="#a67f4e" />
            <polygon points={plane} fill="#d8b98b" />
            {deckSeams.map((d) => <path d={d} stroke="#b89264" stroke-width="1.5" fill="none" />)}
          </g></g>
          <g class="l" style="--i:1"><g class="e">
            <polygon points={band(0, 0.24)} fill="#2d2d2b" />
          </g></g>
          <g class="l" style="--i:2"><g class="e">
            <polygon points={plane} fill="#9d9c95" />
            {underlayLines.map((d) => <path d={d} stroke="rgba(255,255,255,0.45)" stroke-width="1" fill="none" />)}
          </g></g>
          <g class="l" style="--i:3"><g class="e">
            <polygon points={band(0, 0.07)} fill="#232323" />
          </g></g>
          <g class="l" style="--i:4"><g class="e">
            {shingleRows.map((r) => <polygon points={r.poly} fill={r.shade} />)}
            {ticks.map((d) => <path d={d} stroke="rgba(0,0,0,0.35)" stroke-width="1" fill="none" />)}
            {shingleRows.map((r) => { const p = at(r.t); return <path d={`M${p.xl},${p.y} L${p.xr},${p.y}`} stroke="rgba(0,0,0,0.5)" stroke-width="1.2" fill="none" />; })}
          </g></g>
          <g class="l" style="--i:5"><g class="e">
            <polygon points={band(0.93, 1)} fill="#1f2022" />
            <path d={`M${TL[0]},${TL[1] - 3} L${TR[0]},${TR[1] - 3}`} stroke="#c9933e" stroke-width="3" fill="none" />
            <path d={`M${BL[0]},${BL[1] + 1} L${BR[0]},${BR[1] + 1}`} stroke="#c9933e" stroke-width="3" fill="none" />
          </g></g>
        </svg>
      </div>

      <div class="copy">
        <ol class="steps" aria-label="Roof system layers">
          {
            layers.map((l, i) => (
              <li style={`--i:${i}`}>
                <span class="step-name">{l.name}</span>
                <span class="step-text">{l.text}</span>
              </li>
            ))
          }
        </ol>
        <div class="controls">
          <button type="button" class="btn btn-secondary" data-replay>Replay the sequence</button>
          <button type="button" class="btn btn-quiet" data-pause aria-pressed="false">Pause animation</button>
        </div>
        <p class="fine">Illustration of a typical asphalt shingle roof system. Not a photo or a record of a specific project.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid-layers {
    display: grid;
    gap: 2.5rem;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
    display: grid;
    gap: 0.35rem;
  }
  .steps li {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0 0.7rem 1.1rem;
    border-left: 2px solid var(--on-ink-line);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .step-name {
    font-weight: 600;
    color: var(--on-ink);
  }
  .step-text {
    font-size: var(--text-sm);
    color: var(--on-ink-muted);
    max-width: 46ch;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .btn-quiet {
    background: transparent;
    color: var(--on-ink);
    border-color: var(--on-ink-line);
  }
  .btn-quiet:hover {
    border-color: var(--on-ink);
    color: var(--on-ink);
  }
  .fine {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--on-ink-muted);
  }
  .art {
    position: relative;
    align-self: center;
    padding: 0.5rem 0;
  }
  .art svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .l {
    opacity: 1;
  }
  .e {
    transform: translateY(0);
  }

  /* Animation runs only with JS present and motion allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .js .layers.is-armed .l {
      opacity: 0;
    }
    .js .layers.is-playing .l {
      animation: layer-in 620ms var(--ease-out) calc(var(--i) * 560ms) both;
    }
    .js .layers.is-playing .e {
      animation: layer-collapse 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 4600ms both;
    }
    .js .layers.is-playing .steps li {
      animation: step-on 300ms ease calc(var(--i) * 560ms + 200ms) both;
    }
    .js .layers.is-paused .l,
    .js .layers.is-paused .e,
    .js .layers.is-paused .steps li {
      animation-play-state: paused;
    }
  }
  @keyframes layer-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes layer-collapse {
    from {
      transform: translateY(calc(var(--i) * -38px));
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes step-on {
    from {
      border-color: var(--on-ink-line);
    }
    to {
      border-color: var(--gold);
    }
  }
  @media (min-width: 45em) and (max-width: 59.9375em) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 2rem;
    }
  }
  @media (min-width: 60em) {
    .grid-layers {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: center;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-layers]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]');
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    let played = false;

    const play = () => {
      root.classList.remove('is-playing', 'is-paused');
      pause?.setAttribute('aria-pressed', 'false');
      if (pause) pause.textContent = 'Pause animation';
      // Two frames later the class comes back, which restarts the CSS animations without a forced reflow.
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-armed', 'is-playing')));
    };

    if (!reduced.matches && 'IntersectionObserver' in window) {
      root.classList.add('is-armed');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !played) {
              played = true;
              play();
            } else if (!e.isIntersecting && played) {
              root.classList.add('is-paused');
            } else if (e.isIntersecting && played && pause?.getAttribute('aria-pressed') !== 'true') {
              root.classList.remove('is-paused');
            }
          }
        },
        { threshold: 0.35 },
      );
      io.observe(root);
      // Safety: never leave the drawing hidden if the observer misses.
      window.setTimeout(() => {
        if (!played) root.classList.remove('is-armed');
      }, 6000);
    }

    replay?.addEventListener('click', () => {
      if (reduced.matches) return;
      played = true;
      play();
    });
    pause?.addEventListener('click', () => {
      const pressed = pause.getAttribute('aria-pressed') === 'true';
      pause.setAttribute('aria-pressed', String(!pressed));
      pause.textContent = pressed ? 'Pause animation' : 'Resume animation';
      root.classList.toggle('is-paused', !pressed);
    });
    reduced.addEventListener('change', () => {
      if (reduced.matches) root.classList.remove('is-armed', 'is-playing', 'is-paused');
    });
  }
</script>
