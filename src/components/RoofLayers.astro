---
// The six layers of a shingle roof system, explained beside a photo of a SHYLD crew installing them.
import { Picture } from 'astro:assets';
import farmhouse from '../assets/photos/farmhouse-replacement-in-progress.jpg';

const layers = [
  { name: 'Roof deck', text: 'Plywood or OSB sheathing. Checked after tear off and replaced where it is soft.' },
  { name: 'Ice and water barrier', text: 'Self sealing membrane at the eaves, valleys, and around penetrations.' },
  { name: 'Synthetic underlayment', text: 'A second water barrier across the whole deck, under everything you can see. The printed sheet in the photo.' },
  { name: 'Starter strip', text: 'Seals the first course of shingles against wind lift at the edge.' },
  { name: 'Architectural shingles', text: 'Or metal panels on a metal system. The part that shows, and the part that takes the weather.' },
  { name: 'Ridge vent, flashing, and drip edge', text: 'Where most leaks begin and where the details earn their keep.' },
];
---

<section class="layers section section-ink" aria-labelledby="layers-heading">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">How a roof goes together</p>
        <h2 id="layers-heading">Six layers between the weather and your ceiling.</h2>
      </div>
      <p class="lede">A new roof is more than shingles. When we write a proposal, every one of these layers is listed so you can see what you are paying for.</p>
    </div>

    <div class="grid-layers">
      <figure class="photo rise">
        <div class="frame">
          <Picture
            src={farmhouse}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 60em) 58vw, 100vw"
            formats={['avif', 'webp']}
            alt="Aerial view of a SHYLD crew installing charcoal shingles on a two story farmhouse, with printed synthetic underlayment still exposed on the porch roof"
            loading="lazy"
          />
        </div>
        <figcaption class="caption">Underlayment down, shingles going on. A SHYLD replacement photographed mid installation.</figcaption>
      </figure>

      <ol class="steps rise" aria-label="Roof system layers">
        {
          layers.map((l) => (
            <li>
              <span class="step-name">{l.name}</span>
              <span class="step-text">{l.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .grid-layers {
    display: grid;
    gap: 2.5rem;
  }
  .photo {
    margin: 0;
  }
  .photo .frame {
    aspect-ratio: 4 / 3;
  }
  .photo .caption {
    color: var(--on-ink-muted);
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .steps li {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0 0.7rem 1.1rem;
    border-left: 2px solid var(--gold);
  }
  .step-name {
    font-weight: 600;
    color: var(--on-ink);
  }
  .step-text {
    font-size: var(--text-sm);
    color: var(--on-ink-muted);
    max-width: 46ch;
  }
  @media (min-width: 45em) and (max-width: 59.9375em) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 2rem;
    }
  }
  @media (min-width: 60em) {
    .grid-layers {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: center;
    }
    .photo .frame {
      aspect-ratio: 16 / 11;
    }
  }
</style>
