---
import { getImage } from 'astro:assets';
import { business, nav } from '../data/business';
import wide from '../assets/photos/crops/hero2-wide.jpg';
import tall from '../assets/photos/crops/hero2-tall.jpg';

const wideAvif = await getImage({ src: wide, widths: [660, 960, 1320], format: 'avif', quality: 58 });
const wideWebp = await getImage({ src: wide, widths: [660, 960, 1320], format: 'webp', quality: 76 });
const tallAvif = await getImage({ src: tall, widths: [480, 640, 781], format: 'avif', quality: 55 });
const tallWebp = await getImage({ src: tall, widths: [480, 640, 781], format: 'webp', quality: 74 });
const fallback = await getImage({ src: wide, width: 1320, format: 'jpeg', quality: 78 });
const alt = 'Aerial view of a white board and batten home with a new charcoal architectural shingle roof, photographed on a SHYLD job';
---

<Fragment slot="head">
  <link rel="preload" as="image" type="image/avif" fetchpriority="high" media="(max-width: 56.1875em)" imagesrcset={tallAvif.srcSet.attribute} imagesizes="100vw" />
  <link rel="preload" as="image" type="image/avif" fetchpriority="high" media="(min-width: 56.25em)" imagesrcset={wideAvif.srcSet.attribute} imagesizes="(min-width: 82.5em) 1240px, 100vw" />
</Fragment>

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="stage">
      <div class="panel">
        <p class="eyebrow">Middle Tennessee roofing</p>
        <h1 id="hero-heading">Roofing worth <em>coming home to.</em></h1>
        <p class="lede">Roof replacements, repairs, and metal roofing for homeowners across Middle Tennessee. Clear answers before any work begins.</p>
        <div class="actions">
          <a class="btn btn-primary" href={nav.cta.href} data-cta="hero_inspection">Request a Free Inspection</a>
          <a class="btn btn-secondary" href={business.phone.tel} data-cta="hero_call">Call SHYLD Roofing</a>
        </div>
        <p class="phone-line">
          Call or text <a href={business.phone.tel}>{business.phone.display}</a>, Monday to Saturday.
        </p>
      </div>

      <figure class="photo frame">
        <picture>
          <source media="(max-width: 56.1875em)" type="image/avif" srcset={tallAvif.srcSet.attribute} sizes="100vw" />
          <source media="(max-width: 56.1875em)" type="image/webp" srcset={tallWebp.srcSet.attribute} sizes="100vw" />
          <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes="(min-width: 82.5em) 1240px, 100vw" />
          <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes="(min-width: 82.5em) 1240px, 100vw" />
          <img
            src={fallback.src}
            width={wide.width}
            height={wide.height}
            alt={alt}
            fetchpriority="high"
            decoding="async"
            loading="eager"
          />
        </picture>
        <figcaption class="tag">Shingle replacement, aerial photo from a SHYLD job</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 3vw, 2.5rem) 0;
  }
  .stage {
    display: grid;
    gap: 1.25rem;
  }
  .panel {
    order: 1;
    padding: clamp(0.5rem, 3vw, 2.75rem) 0 0.5rem;
  }
  .photo {
    order: 2;
    margin: 0;
    aspect-ratio: 1 / 1;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: rgba(23, 24, 23, 0.7);
    color: var(--on-ink);
    font-size: 0.8rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  h1 {
    max-width: 14ch;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .phone-line {
    margin-top: 1.1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .phone-line a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1.5px solid var(--gold);
  }
  @media (max-width: 29.9375em) {
    .actions .btn {
      width: 100%;
    }
  }
  @media (min-width: 56.25em) {
    .hero {
      padding-bottom: 4.5rem;
    }
    .stage {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }
    .panel,
    .photo {
      grid-area: 1 / 1;
    }
    .photo {
      width: 100%;
      max-width: 100%;
      aspect-ratio: 16 / 7;
      min-height: 520px;
      max-height: 720px;
      box-shadow: var(--shadow-soft);
    }
    .photo img {
      object-position: 50% 40%;
    }
    .tag {
      left: auto;
      right: 1.25rem;
      bottom: 1.25rem;
      max-width: min(34%, 22rem);
      text-align: right;
    }
    .panel {
      position: relative;
      z-index: 2;
      align-self: end;
      justify-self: start;
      width: min(600px, 62%);
      margin: 0 0 -4.5rem clamp(1.25rem, 4vw, 3.5rem);
      padding: clamp(1.75rem, 3vw, 2.75rem);
      background: var(--white);
      border-radius: var(--radius-media);
      box-shadow: var(--shadow-soft);
    }
  }
  @media (min-width: 75em) {
    .panel {
      width: min(620px, 52%);
    }
  }
</style>
