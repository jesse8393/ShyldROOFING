---
import InquiryForm from './InquiryForm.astro';
import { business } from '../data/business';

interface Props {
  heading?: string;
  intro?: string;
  service?: string;
  city?: string;
  formHeading?: string;
  id?: string;
  /** Put the form before the contact details on small screens */
  formFirst?: boolean;
}
const {
  heading = 'Start with a free inspection.',
  intro = 'A short form is all it takes. We will call or text to set a time, look at the roof, and tell you what we see.',
  service,
  city,
  formHeading,
  id = 'inspection',
  formFirst = false,
} = Astro.props;
---

<section class="contact section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="layout">
      <div class="copy rise">
        <p class="eyebrow">Get in touch</p>
        <h2 id="contact-heading">{heading}</h2>
        <p class="lede">{intro}</p>
        <dl class="rows details">
          <div>
            <dt>Call</dt>
            <dd><a href={business.phone.tel} data-cta="contact_call">{business.phone.display}</a></dd>
          </div>
          <div>
            <dt>Text</dt>
            <dd><a href={business.phone.sms} data-cta="contact_text">{business.phone.display}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>
              {business.hours.map((h) => <span>{h.days}, {h.open} to {h.close}</span>)}
            </dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>{business.address.locality}, Tennessee. Serving Middle Tennessee.</dd>
          </div>
        </dl>
      </div>
      <div class:list={['form', 'rise', { 'form-first': formFirst }]}>
        <InquiryForm id={id} service={service} city={city} heading={formHeading} />
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 2.5rem;
  }
  .copy .lede {
    margin-top: 1.25rem;
  }
  .details {
    margin: 2rem 0 0;
  }
  .details > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
  }
  dd {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  dd a {
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1.5px solid var(--gold);
    width: fit-content;
  }
  dd a:hover {
    color: var(--gold-deep);
  }
  @media (max-width: 59.9375em) {
    .form-first {
      order: -1;
    }
  }
  @media (min-width: 60em) {
    .layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 6vw, 5rem);
      align-items: start;
    }
  }
</style>
