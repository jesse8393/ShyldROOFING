---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { areas, business } from '../data/business';

interface Props {
  title: string;
  description: string;
  /** Canonical path beginning with a slash, for example "/roof-repair" */
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Additional JSON-LD objects for this page. The organization graph is added automatically. */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail. Home is added automatically. */
  crumbs?: { name: string; path: string }[];
  bodyClass?: string;
  hideMobileBar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og/shyld-roofing.jpg',
  ogImageAlt = 'Aerial view of a charcoal shingle roof on a white board and batten home, installed by SHYLD Roofing',
  noindex = false,
  schema = [],
  crumbs = [],
  bodyClass = '',
  hideMobileBar = false,
} = Astro.props;

const site = business.url;
const canonical = path === '/' ? `${site}/` : `${site}${path}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;

const organization = {
  '@type': 'RoofingContractor',
  '@id': `${site}/#business`,
  name: business.name,
  legalName: business.legalName,
  url: `${site}/`,
  telephone: business.phone.e164,
  email: business.email,
  image: `${site}/og/shyld-roofing.jpg`,
  logo: `${site}/brand/shyld-primary-black.svg`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '18:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '14:00' },
  ],
  areaServed: areas.map((a) => ({ '@type': 'City', name: a.name, containedInPlace: { '@type': 'State', name: 'Tennessee' } })),
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.name,
      item: `${site}${c.path}`,
    })),
  ],
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, ...(crumbs.length ? [breadcrumb] : []), ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f4ee" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/shyld-shield-gold.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, { 'has-mobile-bar': !hideMobileBar }]}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideMobileBar && <MobileBar />}
    <script>
      import '../scripts/reveal';
      import '../scripts/track';
    </script>
  </body>
</html>
