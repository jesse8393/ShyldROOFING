---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import { projects } from '../data/projects';
import { services } from '../data/business';
import shingles from '../assets/photos/shingle-replacement-aerial.jpg';
import metal from '../assets/photos/standing-seam-metal-aerial.jpg';
import siding from '../assets/photos/board-and-batten-siding.jpg';
import gutters from '../assets/photos/seamless-gutters-brick-home.jpg';
import charcoalHome from '../assets/photos/home-charcoal-shingles-aerial.jpg';
import farmhouse from '../assets/photos/farmhouse-replacement-in-progress.jpg';
import blueRanch from '../assets/photos/blue-brick-ranch-hip-roof-aerial.jpg';
import blueRanchFront from '../assets/photos/blue-brick-ranch-front-aerial.jpg';
import addition from '../assets/photos/shingle-and-flat-roof-addition-aerial.jpg';
const images: Record<string, typeof shingles> = {
  'charcoal-shingles-board-and-batten-home': charcoalHome,
  'farmhouse-roof-replacement-in-progress': farmhouse,
  'blue-brick-ranch-hip-roof': blueRanch,
  'shingle-and-flat-roof-addition': addition,
  'architectural-shingle-replacement': shingles,
  'standing-seam-metal-roof': metal,
  'board-and-batten-siding': siding,
  'seamless-gutters': gutters,
};
---

<Base
  title="Projects | Roof, Siding, and Gutter Work by SHYLD Roofing"
  description="Photos from SHYLD Roofing jobs in Middle Tennessee: shingle replacement, standing seam metal, board and batten siding, and seamless gutters."
  path="/projects"
  crumbs={[{ name: 'Projects', path: '/projects' }]}
>
  <header class="page-head">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Projects</li></ol>
      <p class="eyebrow">Our work</p>
      <h1>Photographed on the job, described as it was.</h1>
      <p class="lede">Every image here is from a SHYLD project. We describe what the photo shows and nothing more. As we photograph more jobs, this page grows.</p>
    </div>
  </header>

  <section class="section-sm section-white">
    <div class="container list">
      {
        projects.map((p, i) => {
          const svc = services.find((s) => s.slug === p.service)!;
          return (
            <article class="project rise" id={p.slug}>
              <div class="frame">
                <Picture src={images[p.slug]} widths={[640, 960, 1280, 1600]} sizes="(min-width: 56.25em) 58vw, 100vw" formats={['avif', 'webp']} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
              <div class="text">
                <p class="eyebrow">{svc.name}</p>
                <h2>{p.title}</h2>
                <p class="summary">{p.summary}</p>
                <div class="prose">{p.body.map((t) => <p>{t}</p>)}</div>
                <a class="arrow-link" href={`/${svc.slug}`} data-track="service">About {svc.name.toLowerCase()} <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <ContactSection heading="Want your roof to be next?" intro="Start with a free inspection. We will photograph it, explain what we see, and put everything in writing." />
</Base>

<style>
  .list {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }
  .project {
    display: grid;
    gap: 1.5rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .frames {
    display: grid;
    gap: 1rem;
  }
  .project .frame {
    aspect-ratio: 4 / 3;
  }
  .project :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .summary {
    margin: 0.75rem 0 1.25rem;
    color: var(--muted);
  }
  .text .arrow-link {
    margin-top: 1.25rem;
  }
  @media (min-width: 56.25em) {
    .project {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .project:nth-child(even) .frames {
      order: 2;
    }
  }
</style>
