---
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import { areas, business } from '../data/business';
import { locationContent } from '../data/location-content';
const counties = [...new Set(areas.map((a) => a.county))];
---

<Base
  title="Service Areas | SHYLD Roofing, Middle Tennessee"
  description="SHYLD Roofing serves 14 Middle Tennessee towns, from Murfreesboro and Smyrna to Franklin, Nashville, Lebanon, and Shelbyville. See every area we cover."
  path="/service-areas"
  crumbs={[{ name: 'Service areas', path: '/service-areas' }]}
>
  <header class="page-head">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Service areas</li></ol>
      <p class="eyebrow">Where we work</p>
      <h1>Middle Tennessee, county by county.</h1>
      <p class="lede">SHYLD is based in {business.address.locality} and serves the towns below. If yours is close but not listed, call <a href={business.phone.tel}>{business.phone.display}</a> and we will tell you whether it is in our range.</p>
    </div>
  </header>
  <section class="section-sm section-white">
    <div class="container">
      {
        counties.map((county) => (
          <div class="county rise">
            <h2>{county}</h2>
            <ul>
              {areas.filter((a) => a.county === county).map((a) => (
                <li>
                  <h3><a href={`/roofing-${a.slug}`}>Roofing in {a.name}</a></h3>
                  <p>{locationContent[a.slug].intro}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <ContactSection heading="Not sure if we cover your address?" intro="Send the city and what you have noticed. We will reply either way." />
</Base>

<style>
  .county {
    display: grid;
    gap: 1rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .county h2 {
    font-size: var(--text-h3);
  }
  .county ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }
  .county h3 {
    font-size: var(--text-h4, 1.125rem);
    margin: 0 0 0.35rem;
  }
  .county h3 a {
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }
  .county p {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-soft, inherit);
  }
  @media (min-width: 45em) {
    .county {
      grid-template-columns: 16rem 1fr;
      align-items: start;
    }
  }
</style>
