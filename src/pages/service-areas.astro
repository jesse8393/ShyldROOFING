---
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import { areas, business } from '../data/business';
const counties = [...new Set(areas.map((a) => a.county))];
---

<Base
  title="Service Areas | SHYLD Roofing, Middle Tennessee"
  description="SHYLD Roofing serves Franklin, Lebanon, Murfreesboro, Nashville, Brentwood, Nolensville, Spring Hill, Mt. Juliet, Shelbyville, and nearby towns. See every area."
  path="/service-areas"
  crumbs={[{ name: 'Service areas', path: '/service-areas' }]}
>
  <header class="page-head">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Service areas</li></ol>
      <p class="eyebrow">Where we work</p>
      <h1>Middle Tennessee, county by county.</h1>
      <p class="lede">SHYLD is based in {business.address.locality} and serves the towns below regularly. If yours is close but not listed, call <a href={business.phone.tel}>{business.phone.display}</a> and we will tell you honestly whether it is in our range.</p>
    </div>
  </header>
  <section class="section-sm section-white">
    <div class="container">
      {
        counties.map((county) => (
          <div class="county rise">
            <h2>{county}</h2>
            <ul>
              {areas.filter((a) => a.county === county).map((a) => (
                <li><a href={`/roofing-${a.slug}`}>{a.name}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <ContactSection heading="Not sure if we cover your address?" intro="Send the city and what you have noticed. We will reply either way." />
</Base>

<style>
  .county {
    display: grid;
    gap: 1rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .county h2 {
    font-size: var(--text-h3);
  }
  .county ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .county a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--paper);
    text-decoration: none;
    font-weight: 500;
  }
  .county a:hover {
    border-color: var(--gold);
  }
  @media (min-width: 45em) {
    .county {
      grid-template-columns: 16rem 1fr;
      align-items: start;
    }
  }
</style>
